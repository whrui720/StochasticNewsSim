\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Cross-event replication: Hurricane Harvey 2017}{13}{subsection.3.3}\protected@file@percent }
\newlabel{sec:results-harvey}{{3.3}{13}{Cross-event replication: Hurricane Harvey 2017}{subsection.3.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Part A on Hurricane Harvey 2017. Pure Hawkes-AR1 wins; the hybrid provides no improvement because the hybrid optimizer collapses the IHP component (the fitted $A$ is essentially zero), reflecting that Harvey's coverage builds endogenously over multiple days rather than through a sharp day-0 shock.}}{13}{table.caption.42}\protected@file@percent }
\newlabel{tab:harvey-partA}{{6}{13}{Part A on Hurricane Harvey 2017. Pure Hawkes-AR1 wins; the hybrid provides no improvement because the hybrid optimizer collapses the IHP component (the fitted $A$ is essentially zero), reflecting that Harvey's coverage builds endogenously over multiple days rather than through a sharp day-0 shock}{table.caption.42}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Part B on Hurricane Harvey 2017. State-dependent Markov is again the AIC winner, but the homogeneous baseline is much closer than on Las Vegas: the system spends little time in the rare regime, so regime-specific corrections buy less.}}{13}{table.caption.43}\protected@file@percent }
\newlabel{tab:harvey-partB}{{7}{13}{Part B on Hurricane Harvey 2017. State-dependent Markov is again the AIC winner, but the homogeneous baseline is much closer than on Las Vegas: the system spends little time in the rare regime, so regime-specific corrections buy less}{table.caption.43}{}}
