\@writefile{toc}{\contentsline {paragraph}{Profile sweep and AR(1) collapse.}{6}{section*.17}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Profile log-likelihood of the discrete-time Hawkes model on Las Vegas 2017 over a log-grid in the kernel decay $\beta $. Re-optimization of $(\mu ,n)$ at each fixed $\beta $. The profile is monotone in $\beta $ and plateaus at $\beta \geq 10$, where the kernel collapses to a one-step lag.}}{6}{table.caption.18}\protected@file@percent }
\newlabel{tab:beta-profile}{{1}{6}{Profile log-likelihood of the discrete-time Hawkes model on Las Vegas 2017 over a log-grid in the kernel decay $\beta $. Re-optimization of $(\mu ,n)$ at each fixed $\beta $. The profile is monotone in $\beta $ and plateaus at $\beta \geq 10$, where the kernel collapses to a one-step lag}{table.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Hawkes profile log-likelihood vs.\ kernel decay $\beta $ on Las Vegas 2017. Monotone in $\beta $, plateauing for $\beta \!\geq \!10$. The plateau is the AR(1) limit of \eqref  {eq:ar1} with $\hat  \mu \approx 11.50$, $\hat  n\approx 0.614$.}}{7}{figure.caption.19}\protected@file@percent }
\newlabel{fig:partA-beta-profile}{{2}{7}{Hawkes profile log-likelihood vs.\ kernel decay $\beta $ on Las Vegas 2017. Monotone in $\beta $, plateauing for $\beta \!\geq \!10$. The plateau is the AR(1) limit of \eqref {eq:ar1} with $\hat \mu \approx 11.50$, $\hat n\approx 0.614$}{figure.caption.19}{}}
